---
import Icon from './Icons.astro';
interface Props { items: { q: string; a: string }[]; group?: string; }
const { items, group = 'faq' } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details class="faq-item" name={group}>
      <summary>
        <span class="faq-q">{f.q}</span>
        <span class="faq-icon" aria-hidden="true"><Icon name="plus" /></span>
      </summary>
      <div class="faq-body"><p>{f.a}</p></div>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--line); }
  .faq-item { border-bottom: 1px solid var(--line); }
  .faq-item summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.2rem 0; font-weight: 600; font-size: 1.12rem; color: var(--navy-900); line-height: 1.35; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover .faq-q { color: var(--sky-700); }
  .faq-icon { width: 36px; height: 36px; border-radius: 50%; background: var(--sky-100); color: var(--navy-900); display: grid; place-items: center; flex-shrink: 0; transition: transform 0.25s var(--ease), background 0.2s, color 0.2s; }
  .faq-icon :global(.icon) { width: 18px; height: 18px; }
  .faq-item[open] .faq-icon { transform: rotate(45deg); background: var(--navy-900); color: #fff; }
  .faq-body { padding: 0 3.2rem 1.3rem 0; color: var(--ink-soft); max-width: 72ch; }
  .faq-body p { margin: 0; }
</style>
