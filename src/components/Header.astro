---
import { site } from '../data/site';
import Icon from './Icons.astro';
const path = Astro.url.pathname;
const is = (p: string) => path === p || (p !== '/' && path.startsWith(p));
const links = [
  { href: '/medicare/', label: 'Medicare 101' },
  { href: '/about/', label: 'Our Team' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/contact/', label: 'Contact' },
];
const a = site.announcement;
---
{a.text && (
  <div class="announce">
    <div class="container announce-inner">
      <Icon name="calendar" />
      <span>{a.text}</span>
      <a href={a.href}>{a.cta} <Icon name="arrow" /></a>
    </div>
  </div>
)}
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="One2One Insurance Advisors home">
      <img src="/images/logo.png" alt="One2One Insurance Advisors" width="450" height="247" />
    </a>
    <nav class="nav" aria-label="Main">
      <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
      <label for="nav-toggle" class="nav-toggle" aria-label="Open menu"><span></span><span></span><span></span></label>
      <ul class="nav-list">
        {links.map((l) => (
          <li><a href={l.href} aria-current={is(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li class="nav-phone"><a href={site.phoneHref}><Icon name="phone" /> {site.phone}</a></li>
        <li class="nav-cta"><a href="/contact/" class="btn btn-primary">Schedule a Call</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .announce { background: var(--navy-900); color: #dfe6f3; font-size: 0.92rem; }
  .announce-inner { display: flex; align-items: center; justify-content: center; gap: 0.6rem; padding: 0.55rem 0; flex-wrap: wrap; text-align: center; }
  .announce .icon { color: var(--sky-400); width: 1.1rem; height: 1.1rem; }
  .announce a { color: #fff; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem; border-bottom: 1px solid rgba(255,255,255,0.35); }
  .announce a:hover { border-color: #fff; }
  .announce a .icon { color: var(--gold-400); width: 1rem; height: 1rem; }

  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(248, 247, 243, 0.86);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    transition: box-shadow 0.25s, border-color 0.25s, background 0.25s;
  }
  .site-header:global(.scrolled) { border-color: var(--line); background: rgba(255, 255, 255, 0.92); box-shadow: 0 6px 24px rgba(26, 28, 66, 0.07); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.5rem 0; position: relative; }
  .brand { display: block; flex-shrink: 0; }
  .brand img { height: 66px; width: auto; }

  .nav-list { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 0.15rem; }
  .nav-list > li > a { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.6rem 0.95rem; border-radius: 999px; font-weight: 500; font-size: 1rem; color: var(--ink); text-decoration: none; transition: background 0.15s, color 0.15s; }
  .nav-list > li:not(.nav-cta) > a:hover, .nav-list > li > a[aria-current="page"] { background: var(--sky-100); color: var(--navy-900); }
  .nav-phone a { font-weight: 600 !important; color: var(--navy-900) !important; margin-left: 0.4rem; }
  .nav-phone :global(.icon) { color: var(--sky-600); }
  .nav-list > li.nav-cta > a.btn { margin-left: 0.35rem; padding: 0.7rem 1.25rem; font-size: 0.95rem; color: #fff; background: var(--navy-900); }
  .nav-list > li.nav-cta > a.btn:hover { background: var(--navy-800); color: #fff; }

  .nav-toggle-input { display: none; }
  .nav-toggle { display: none; width: 46px; height: 46px; border-radius: 12px; border: 1px solid var(--line); background: var(--paper); cursor: pointer; flex-direction: column; justify-content: center; align-items: center; gap: 5px; }
  .nav-toggle span { display: block; width: 20px; height: 2px; background: var(--navy-900); border-radius: 2px; transition: transform 0.25s var(--ease), opacity 0.2s; }
  .nav-toggle-input:checked + .nav-toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle-input:checked + .nav-toggle span:nth-child(2) { opacity: 0; }
  .nav-toggle-input:checked + .nav-toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 1000px) {
    .nav-toggle { display: flex; }
    .nav-list { display: none; position: absolute; left: 0; right: 0; top: calc(100% + 1px); background: var(--paper); border-bottom: 1px solid var(--line); flex-direction: column; align-items: stretch; padding: 0.75rem 1.25rem 1.25rem; gap: 0.1rem; box-shadow: var(--shadow); }
    .nav-toggle-input:checked ~ .nav-list { display: flex; }
    .nav-list > li > a { display: flex; padding: 0.9rem 0.8rem; font-size: 1.08rem; border-radius: 10px; }
    .nav-phone a { margin: 0; }
    .nav-cta a.btn { margin: 0.75rem 0 0; width: 100%; justify-content: center; }
    .brand img { height: 56px; }
  }
</style>
