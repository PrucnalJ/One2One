---
import { url } from '../lib/url';
import { site } from '../data/site';
import Icon from './Icons.astro';
interface Props { title?: string; text?: string; }
const {
  title = 'Ready to Make Medicare Simple?',
  text = "Whether you're turning 65, reviewing your current plan, or just have questions — we're here to help, and it's always free.",
} = Astro.props;
---
<section class="cta-band">
  <div class="container cta-inner">
    <div class="cta-copy">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <a href={url('/contact/')} class="btn btn-gold btn-lg">Schedule a Call <Icon name="arrow" /></a>
      <a href={site.phoneHref} class="btn btn-ghost-light btn-lg"><Icon name="phone" /> {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta-band { position: relative; overflow: hidden; background: linear-gradient(135deg, var(--navy-950) 0%, var(--navy-900) 55%, var(--navy-700) 100%); color: #fff; padding: clamp(3rem, 7vw, 5.5rem) 0; }
  .cta-band::before { content: ""; position: absolute; width: 520px; height: 520px; border-radius: 50%; right: -160px; top: -220px; background: radial-gradient(circle, rgba(136, 189, 224, 0.35), transparent 65%); pointer-events: none; }
  .cta-band::after { content: ""; position: absolute; width: 380px; height: 380px; border-radius: 50%; left: -140px; bottom: -200px; background: radial-gradient(circle, rgba(230, 168, 58, 0.22), transparent 65%); pointer-events: none; }
  .cta-inner { position: relative; display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem; align-items: center; }
  .cta-copy h2 { color: #fff; margin-bottom: 0.6rem; }
  .cta-copy p { color: #c9d3e6; font-size: 1.15rem; margin: 0; max-width: 56ch; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: flex-end; }
  @media (max-width: 900px) { .cta-inner { grid-template-columns: 1fr; } .cta-actions { justify-content: flex-start; } }
</style>
