---
import { url } from '../lib/url';
import { site } from '../data/site';
import Icon from './Icons.astro';
const year = new Date().getFullYear();
const socials = [
  { key: 'facebook', label: 'Facebook', href: site.social.facebook },
  { key: 'x', label: 'X', href: site.social.x },
  { key: 'instagram', label: 'Instagram', href: site.social.instagram },
].filter((s) => s.href);
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={url('/')} aria-label="One2One Insurance Advisors home"><img src={url('/images/logo.png')} alt="One2One Insurance Advisors" width="450" height="247" loading="lazy" /></a>
        <p>Independent Medicare advisors serving Murrysville and Western Pennsylvania. We compare plans across carriers, and our help is always free to you.</p>
        {socials.length > 0 && (
          <div class="social">
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener" aria-label={`${site.shortName} on ${s.label}`}><Icon name={s.key} /></a>
            ))}
          </div>
        )}
      </div>

      <div>
        <h4>Explore</h4>
        <ul>
          <li><a href={url('/')}>Home</a></li>
          <li><a href={url('/medicare/')}>Medicare 101</a></li>
          <li><a href={url('/about/')}>Our Team</a></li>
          <li><a href={url('/faq/')}>FAQ</a></li>
          <li><a href={url('/contact/')}>Contact</a></li>
          <li><a href={url('/privacy/')}>Privacy Policy</a></li>
        </ul>
      </div>

      <div>
        <h4>Contact</h4>
        <ul class="footer-contact">
          <li><Icon name="pin" /><a href={site.mapsUrl} target="_blank" rel="noopener">{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</a></li>
          <li><Icon name="phone" /><a href={site.phoneHref}>{site.phone}</a></li>
          <li><Icon name="mail" /><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><Icon name="clock" /><span>{site.hours[0].day}: {site.hours[0].open} to {site.hours[0].close}<br />{site.hours[1].day} {site.hours[1].note?.toLowerCase()}</span></li>
        </ul>
      </div>

      <div>
        <h4>Monthly newsletter</h4>
        <p class="footer-news">Enrollment reminders, plan change alerts, and Medicare tips in plain English. Once a month, no spam.</p>
        <form class="footer-form" name="newsletter" method="POST" data-netlify="true" netlify-honeypot="company" action={url('/subscribed/')}>
          <input type="hidden" name="form-name" value="newsletter" />
          <p class="visually-hidden" aria-hidden="true"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></p>
          <label class="visually-hidden" for="footer-email">Email address</label>
          <input id="footer-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
          <button type="submit" class="btn btn-primary">Subscribe</button>
        </form>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>We do not offer every plan available in your area. Currently we represent {site.disclaimer.organizations} organizations which offer {site.disclaimer.products} products in your area. Please contact Medicare.gov, 1-800-MEDICARE, or your local State Health Insurance Assistance Program (SHIP) to get information on all of your options.</p>
      <p>{site.name} is not connected with or endorsed by the United States government or the federal Medicare program. Enrollment in a plan may be limited to certain times of the year unless you qualify for a Special Enrollment Period.</p>
      <div class="footer-legal">
        <span>&copy; {year} {site.name}. All rights reserved.</span>
        <span>{site.address.street}, {site.address.city}, {site.address.state} {site.address.zip}</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--paper); border-top: 1px solid var(--line); margin-top: auto; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 0.8fr 1.2fr 1.3fr; gap: 2.5rem; padding: 3.5rem 0 2.75rem; }
  .footer-brand img { height: 76px; width: auto; }
  .footer-brand p { color: var(--ink-soft); max-width: 36ch; margin: 1.1rem 0 1.2rem; font-size: 0.98rem; }
  .social { display: flex; gap: 0.5rem; }
  .social a { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; background: var(--sky-50); color: var(--navy-900); border: 1px solid var(--line); transition: background 0.15s, color 0.15s; }
  .social a:hover { background: var(--navy-900); color: #fff; }
  .social :global(.icon) { width: 20px; height: 20px; }
  .site-footer h4 { font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-mute); margin: 0.4rem 0 1.1rem; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .site-footer li a { color: var(--ink); text-decoration: none; }
  .site-footer li a:hover { color: var(--sky-700); text-decoration: underline; }
  .footer-contact li { display: flex; gap: 0.65rem; align-items: flex-start; line-height: 1.5; }
  .footer-contact :global(.icon) { color: var(--sky-600); margin-top: 0.3rem; width: 1.1rem; height: 1.1rem; }
  .footer-news { color: var(--ink-soft); font-size: 0.98rem; margin: 0 0 0.9rem; }
  .footer-form { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .footer-form input { flex: 1 1 160px; font: inherit; font-size: 1rem; padding: 0.7rem 0.9rem; border: 1.5px solid var(--line-strong); border-radius: 999px; background: #fff; min-width: 0; }
  .footer-form input:focus { outline: none; border-color: var(--sky-600); box-shadow: 0 0 0 4px var(--sky-100); }
  .footer-form .btn { padding: 0.7rem 1.2rem; font-size: 0.95rem; }
  .footer-bottom { background: var(--navy-900); color: rgba(255, 255, 255, 0.72); font-size: 0.86rem; padding: 1.7rem 0; line-height: 1.55; }
  .footer-bottom p { margin: 0 0 0.6rem; max-width: 110ch; }
  .footer-legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1.5rem; margin-top: 1.1rem; padding-top: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.12); color: rgba(255, 255, 255, 0.85); }
  @media (max-width: 1000px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .footer-grid { grid-template-columns: 1fr; gap: 2rem; } }
</style>
