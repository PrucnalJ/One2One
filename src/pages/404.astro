---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Page Not Found" description="That page does not exist." noindex>
  <section class="section">
    <div class="container narrow center">
      <span class="eyebrow">404</span>
      <h1>We couldn't find that page</h1>
      <p class="lead">The link may be out of date. Try one of these instead, or call us at <a href={site.phoneHref}>{site.phone}</a>.</p>
      <p class="links">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/medicare/" class="btn btn-outline">Medicare 101</a>
        <a href="/contact/" class="btn btn-outline">Contact</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .links { display: flex; flex-wrap: wrap; gap: 0.7rem; justify-content: center; }
</style>
