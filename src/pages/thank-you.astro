---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icons.astro';
import { site } from '../data/site';
---
<Base title="Thank You" description="Your message has been received." noindex>
  <section class="section">
    <div class="container narrow center">
      <span class="mark" aria-hidden="true"><Icon name="check" /></span>
      <span class="eyebrow">Message received</span>
      <h1>Thank you for getting in touch!</h1>
      <p class="lead">One of our colleagues will get back to you shortly. Have a great day!</p>
      <p>If you'd rather talk now, call <a href={site.phoneHref}>{site.phone}</a>.</p>
      <p><a href="/" class="btn btn-primary">Back to home</a></p>
    </div>
  </section>
</Base>

<style>
  .mark { width: 72px; height: 72px; border-radius: 50%; background: var(--sky-100); color: var(--navy-900); display: grid; place-items: center; margin: 0 auto 1.4rem; }
  .mark :global(.icon) { width: 34px; height: 34px; }
</style>
